# Copy to .env.supabase-migration (ignored by Git). Fill locally.
# These are PostgreSQL URLs from Connect, not Supabase HTTP API keys.
# Use direct or Session Pooler port 5432; sslmode=verify-full.
# From the repo root add sslrootcert=certs%2Fsupabase-prod-ca-2021.crt.
# Pooled username: role.PROJECT_REF. Direct username: role.
# Percent-encode reserved password characters in the URLs.
ENV=staging
DATABASE_DSN=
DATABASE_ADMIN_DSN=
# Same Redis and write timeout as the target web service.
REDIS_CACHE_DSN=
SERVER_WRITE_TIMEOUT=30s
DATABASE_MAX_IDLE_CONNS=2
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m
LOG_LEVEL=info
