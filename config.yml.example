# Salin menjadi config.yml untuk development lokal. Jangan commit secret asli.
env: "development"
log_level: "info"
graceful_shutdown_timeout: "30s"

server:
  port: "8080"
  # Used in prescription verification QR codes. Production/staging must use HTTPS.
  base_url: "http://localhost:8080"
  cors_allowed_origins:
    - "http://localhost:3000"
    - "http://localhost:5173"
  # Isi X-Forwarded-For hanya jika aplikasi tidak dapat diakses tanpa proxy tepercaya.
  client_ip_header: ""
  read_header_timeout: "5s"
  read_timeout: "15s"
  write_timeout: "30s"
  idle_timeout: "60s"

database:
  # DSN runtime lokal. Di staging/production gunakan user DML least-privilege,
  # sslmode=verify-full, dan endpoint pooled bila memakai Neon. User ini tidak
  # boleh memiliki CREATE pada schema public.
  dsn: "postgresql://postgres:postgres@localhost:5432/medikaone?sslmode=disable"
  # Kosong aman untuk server dan development lokal (migration lokal akan
  # memakai dsn). Di staging/production, berikan direct/non-pooler DSN ini
  # hanya kepada proses migration/reset, bukan kepada proses web.
  admin_dsn: ""
  max_idle_conns: 5
  max_open_conns: 20
  max_conn_lifetime: "1h"

redis:
  # Staging/production wajib rediss:// dengan password/ACL dan server harus
  # memakai maxmemory-policy=noeviction; startup gagal jika policy tidak cocok.
  cache_dsn: "redis://localhost:6379/0"
  max_retry: 3
  max_idle_conns: 5
  max_active_conns: 20
  max_conn_lifetime: "1h"

jwt:
  # Wajib diganti dengan secret acak minimal 32 karakter.
  secret: "development-only-change-this-secret"
  access_ttl: "15m"
  refresh_ttl: "720h"

auth:
  pin_ttl: "10m"
  pin_max_attempts: 5
  pin_resend_cooldown: "1m"
  max_active_sessions: 10
  public_ip_rate_limit: 30
  public_ip_rate_window: "15m"
  login_rate_limit: 10
  login_rate_window: "15m"
  forgot_password_rate_limit: 3
  forgot_password_rate_window: "1h"

smtp:
  # Set true dan isi seluruh nilai SMTP untuk mengirim email.
  enabled: false
  host: "smtp.example.com"
  port: 587
  username: "apikey"
  password: "replace-me"
  from: "no-reply@example.com"
  from_name: "MedikaOne"
  timeout: "15s"
  use_starttls: true

storage:
  enabled: true
  provider: "supabase"
  bucket: "doctor-contracts"
  medical_bucket: "medical-records"
  profile_bucket: "profile-images"
  max_file_size_bytes: 10485760 # 10 MB
  signed_url_ttl: "5m"
  supabase:
    url: "https://your-project-ref.supabase.co"
    secret_key: "" # server-only; prefer SUPABASE_SECRET_KEY in production
